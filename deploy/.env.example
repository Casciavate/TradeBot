# Copy this to .env in the same directory and fill in real values.
# .env is gitignored -- see deploy/.gitignore -- never commit real
# credentials here.

###############################################################################
# IBKR credentials, passed straight to the ib-gateway container.
# This app never sees or stores them -- see docs/DEPLOY.md's Credentials
# section, and https://github.com/gnzsnz/ib-gateway-docker#credentials
# for the upstream project's own handling (including a docker-secrets
# option if you'd rather not put a plaintext password in this file).
###############################################################################
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# paper or live. Starts in paper -- change this only once you've read
# docs/RISK_ARCHITECTURE.md and mean it. This env var only controls which
# IBKR ACCOUNT ib-gateway logs into; it is unrelated to this repo's own
# LIVE_TRADING flag, which execution_layer/connection.py still reads
# separately and which defaults to the paper port either way.
TRADING_MODE=paper

# Interactive Brokers' Secure Login System will still ask you to approve
# a push notification on your phone -- this does not remove 2FA, it
# automates the surrounding TWS/Gateway dialogs. What to do when IBC
# doesn't get that approval in time:
#   restart -- retry the login (needs AUTO_RESTART_TIME set below so it
#              doesn't then also need a *daily* re-approval)
#   exit    -- give up and stop the container
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# Time (hh:mm AM/PM, container's TIME_ZONE) IB Gateway restarts itself
# without requiring a fresh 2FA approval. Pick an off-hours time.
AUTO_RESTART_TIME=11:59 PM

# Container timezone -- affects AUTO_RESTART_TIME above and IB Gateway's
# own clock. Examples: America/New_York, Europe/London, Etc/UTC.
TIME_ZONE=Etc/UTC

###############################################################################
# Control center access token (control_center/auth.py). Required because
# this deployment binds to 0.0.0.0, not loopback. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# A shared token over plain HTTP is weak auth by itself -- pair it with
# Tailscale/WireGuard, or the optional Caddy TLS profile. See docs/UI.md.
###############################################################################
TRADEBOT_UI_TOKEN=
